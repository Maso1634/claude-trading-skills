# Copy to .env (cp .env.example .env), then fill in. Never commit .env.
# chmod 600 .env so only you can read it.

# ---- Alpaca (read-only use: the dashboard only reads account + positions)
# paper = simulated money (paper-api.alpaca.markets)
# live  = your real account (api.alpaca.markets). Use your LIVE key pair with it.
ALPACA_ENV=paper
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ---- Optional: nightly VCP screen in the refresh job
RUN_VCP=false
# Where prices come from:
#   auto = Alpaca SIP daily bars (uses the ALPACA keys above; free plan is fine),
#          then yfinance, then FMP. Shown results are cross-checked against a
#          second source and flagged on the Overview when they disagree.
#   fmp  = FMP quotes only (the old behaviour).
VCP_DATA_SOURCE=auto
# Only needed for VCP_DATA_SOURCE=fmp, or as the last fallback for auto.
FMP_API_KEY=
# Leave empty to screen the whole S&P 500. With VCP_DATA_SOURCE=fmp on a free key
# (250 calls a day, no batch quotes) list about 100 symbols instead, separated by
# spaces, e.g. VCP_UNIVERSE="NVDA MSFT AAPL AMZN META AVGO".
VCP_UNIVERSE=
# Stop after this many FMP calls per run (default 240, leaves a little spare).
VCP_MAX_API_CALLS=
# How many pre-filter survivors get a full price history (default 100).
VCP_MAX_CANDIDATES=

# ---- Optional: drawdown circuit breaker (reads state/theses, no API key)
# Your trading account size in dollars. Leave empty to skip the check.
CB_ACCOUNT_SIZE=
# Optional overrides; defaults are 2% daily, 2 losses -> 24h cooldown, 5% weekly, 8% monthly
CB_MAX_DAILY_LOSS_PCT=
CB_LOSING_STREAK_N=
CB_COOLDOWN_HOURS=
CB_WEEKLY_DRAWDOWN_PCT=
CB_MONTHLY_DRAWDOWN_PCT=

# ---- Optional: ntfy push when the refresh job fails or the VCP data needs a look
# Full topic URL, e.g. https://ntfy.sh/<your-topic> or your own ntfy server.
NTFY_URL=
# Access token, only if the topic requires one (keep it in Vaultwarden too).
NTFY_TOKEN=

# ---- Times on the page
TZ_DISPLAY=America/New_York
